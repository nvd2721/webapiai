# ---- Server-side (never sent to the browser) ----
# New API internal URL. Leave empty to run in demo mode with fake data.
NEWAPI_URL=http://new-api:3000
# 1 USD = this many quota units in New API (default 500000).
NEWAPI_QUOTA_PER_UNIT=500000
# Encrypts the login cookie. 32+ random chars: openssl rand -hex 32
WEB_SESSION_SECRET=
# Crypto top-up service (internal URL + shared secret). PAYMENT_INTERNAL_URL also works.
PAYMENT_API_URL=http://payment:8080
PAYMENT_API_SECRET=

# ---- Public settings (read on the server at request time, so one image fits any domain) ----
SITE_NAME=Aura
SITE_URL=https://example.com
# Gateway relay host customers call. "/v1" at the end is optional. PUBLIC_API_BASE_URL also works.
API_BASE_URL=https://api.example.com
SUPPORT_EMAIL=support@example.com
SUPPORT_TELEGRAM=
SUPPORT_ZALO=
COMPANY_NAME=
TIMEZONE=Asia/Ho_Chi_Minh
# Date shown on the legal pages.
LEGAL_UPDATED=22/10/2026
# Thin bar above the header and where it links. Unset = built-in text, set to empty = hidden.
# ANNOUNCEMENT=Nạp bằng USDT hoặc Bitcoin, không cần thẻ quốc tế.
# ANNOUNCEMENT_LINK=/pricing?tab=promotions
# Referral rewards shown on /pricing and /console/referral. Must match New API's settings (0 = not shown).
REFERRAL_INVITER_USD=0
REFERRAL_INVITEE_USD=0
