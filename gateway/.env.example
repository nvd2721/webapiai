# ======================================================================
#  Mẫu biến môi trường. Sao chép thành .env rồi chạy ./scripts/gen-secrets.sh
#  để điền các mật khẩu ngẫu nhiên. KHÔNG commit file .env lên git.
# ======================================================================

# ---- Tên miền (trỏ bản ghi A về IP VPS; trên Cloudflare để "DNS only") ----
BRAND_NAME=Aura
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
PAY_DOMAIN=pay.example.com
WEB_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ---- Phiên bản New API (đọc docs/UPGRADE trong README trước khi đổi) ----
NEWAPI_VERSION=v0.13.2
TZ=Asia/Ho_Chi_Minh

# ---- Bí mật (gen-secrets.sh tự điền các dòng có giá trị CHANGE_ME) ----
# Đặt một lần rồi giữ cố định. Đổi SESSION_SECRET = mọi người dùng bị đăng xuất.
SESSION_SECRET=CHANGE_ME
CRYPTO_SECRET=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
PAYMENTS_DB_PASSWORD=CHANGE_ME

# ---- Tinh chỉnh gateway ----
STREAMING_TIMEOUT=600
CHANNEL_TEST_FREQUENCY=30
GLOBAL_API_RATE_LIMIT=600
GLOBAL_WEB_RATE_LIMIT=120

# ---- Tài khoản quản trị New API cho script và dịch vụ nạp tiền ----
# Lấy trong console: Cài đặt cá nhân → "Tạo system access token" (đăng nhập bằng tài khoản root).
# ID root thường là 1 (xem ở trang Người dùng).
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=1
# Script quản trị chạy trên VPS gọi cổng nội bộ này.
NEWAPI_ADMIN_URL=http://127.0.0.1:3000

# ---- Bảng giá và khuyến mãi (scripts/newapi_admin.py options) ----
# Credit tặng khi đăng ký, tính bằng USD.
TRIAL_CREDIT_USD=0.5

# ---- Dịch vụ nạp tiền NOWPayments (xem chú thích chi tiết ở ../payment/.env.example) ----
# PUBLIC_URL (=https://PAY_DOMAIN) và SITE_URL (=https://WEB_DOMAIN) được compose tự đặt.
# Website gọi /api/invoices* qua mạng nội bộ bằng PAYMENT_API_SECRET; /api/admin/* dùng PAYMENT_ADMIN_SECRET.
PAYMENT_API_SECRET=CHANGE_ME
PAYMENT_ADMIN_SECRET=CHANGE_ME
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_FEE_PAID_BY_USER=false
QUOTA_PER_USD=500000

# ---- Website Next.js (thread "Website" sẽ dùng) ----
PUBLIC_API_BASE_URL=https://api.example.com/v1
PUBLIC_CONSOLE_URL=https://console.example.com
# Khóa mã hóa cookie phiên của website (gen-secrets.sh tự điền).
WEB_SESSION_SECRET=CHANGE_ME
# Thông tin hiển thị trên website (tùy chọn).
SITE_NAME=Aura
SUPPORT_EMAIL=support@example.com
SUPPORT_TELEGRAM=
SUPPORT_ZALO=
COMPANY_NAME=

# ---- Build context cho profile payment / web (thư mục mã nguồn) ----
PAYMENT_BUILD_CONTEXT=../payment
WEB_BUILD_CONTEXT=../web

# ---- Sao lưu (scripts/backup.sh) ----
BACKUP_DIR=/var/backups/gateway
BACKUP_KEEP_DAYS=30
# Tên remote rclone đã cấu hình tới Cloudflare R2, ví dụ r2:my-bucket/gateway. Để trống = chỉ lưu trên VPS.
RCLONE_REMOTE=
# Bot Telegram báo lỗi sao lưu (tùy chọn).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
