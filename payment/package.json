{
  "name": "payment",
  "version": "0.1.0",
  "private": true,
  "description": "Crypto top-up service (USDT, Bitcoin) via NOWPayments, credits New API balances",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
