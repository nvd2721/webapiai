# ===== Dịch vụ nạp tiền USDT/BTC =====
# Khi chạy trong stack gateway, các biến dưới đây nằm chung file gateway/.env.
# NEWAPI_INTERNAL_URL, PAYMENTS_DATABASE_URL và PORT đã được docker-compose của gateway đặt sẵn.

# Chuỗi bí mật dùng chung với website Next.js (website gọi server-to-server). Tạo bằng: openssl rand -hex 32
PAYMENT_API_SECRET=
# Chuỗi bí mật riêng cho API quản trị đối soát (/api/admin/*). Tạo bằng: openssl rand -hex 32
PAYMENT_ADMIN_SECRET=

# Tên thương hiệu hiện trên hóa đơn NOWPayments.
BRAND_NAME=Aura

# Địa chỉ website (khách quay lại sau khi trả tiền) và địa chỉ công khai của dịch vụ này (nhận IPN).
SITE_URL=https://tenmien.com
PUBLIC_URL=https://pay.tenmien.com

# NOWPayments: Dashboard -> Store Settings -> API key và IPN secret key.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# true để thử bằng tài khoản sandbox (account-sandbox.nowpayments.io), key sandbox khác key thật.
NOWPAYMENTS_SANDBOX=false
# true: khách trả thêm phí cổng; false: anh chịu phí.
NOWPAYMENTS_FEE_PAID_BY_USER=false

# New API: đăng nhập tài khoản root -> Cài đặt cá nhân -> tạo "access token" hệ thống.
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=1
QUOTA_PER_USD=500000

# Tùy chọn
# COIN_LIMITS={"usdttrc20":{"min":5,"max":4000},"usdtbsc":{"min":5,"max":4000},"btc":{"min":20,"max":4000}}
# MAX_OPEN_INVOICES_PER_USER=10
# INVOICE_EXPIRE_HOURS=24

# Chỉ khi chạy riêng ngoài stack gateway:
# PAYMENTS_DATABASE_URL=postgresql://payments:matkhau@localhost:5432/payments
# NEWAPI_INTERNAL_URL=http://localhost:3000
# PORT=8080
