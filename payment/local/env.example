# Bí mật thử nghiệm, chỉ dùng trên máy cá nhân.
PAYMENT_API_SECRET=local-site-secret-0123456789abcdef
PAYMENT_ADMIN_SECRET=local-admin-secret-0123456789abcdef
SITE_URL=http://localhost:3001
# Địa chỉ công khai để NOWPayments gửi IPN về. Trên máy cá nhân để mặc định thì IPN không tới được.
PUBLIC_URL=http://localhost:8080

# Lấy ở https://account-sandbox.nowpayments.io -> Store Settings (key sandbox, không phải key thật).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

# Tạo trong console New API (http://localhost:3000) -> Cài đặt cá nhân -> access token hệ thống.
NEWAPI_ADMIN_TOKEN=
NEWAPI_ADMIN_USER_ID=1
